{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "onlyscrubs",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-17",
  "workers_dev": false,
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "build": {
    "command": "node scripts/build.mjs",
    "cwd": ".",
    "watch_dir": ["site", "content", "client", "data", "scripts"]
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": true
  },
  "kv_namespaces": [
    {
      "binding": "CONFESSIONS_KV",
      "id": "3ca3a6fd6dce4a83a02f133fac5048a2"
    }
  ],
  "routes": [
    {
      "pattern": "onlyscrubs.org/*",
      "zone_name": "onlyscrubs.org"
    }
  ]
}
